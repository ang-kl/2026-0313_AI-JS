    {
      "id": "re0",
      "col": "responsibility",
      "label": "We are seeking a Salesforce Data Analyst to support large-scale system integration projects involving Salesforce and multiple external systems.",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re1",
      "col": "responsibility",
      "label": "You will start by assisting in data mapping and integration work between Salesforce and APIs (e.g. MuleSoft), gaining hands‑on exposure to how data flows across systems. This includes understanding Salesforce data models, integration payloads, and transformation logic.",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re2",
      "col": "responsibility",
      "label": "You will also support testing activities (SIT/UAT) and work closely with experienced consultants across Salesforce, integration, and functional teams.",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re3",
      "col": "responsibility",
      "label": "Over time, this role can evolve into a Business Analyst or Developer track, depending on project needs and your interests.",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re4",
      "col": "responsibility",
      "label": "This role is suited for individuals who are detail-oriented, structured, and proactive, and who are interested in understanding how enterprise systems connect and operate end‑to‑end.",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re5",
      "col": "responsibility",
      "label": "Data Mapping & Integration Support",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re6",
      "col": "responsibility",
      "label": "Work closely with functional, integration (MuleSoft) and data migration teams to support end‑to‑end delivery.",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re7",
      "col": "responsibility",
      "label": "Assist in mapping data between Salesforce objects and external systems via APIs.",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re8",
      "col": "responsibility",
      "label": "Analyse field definitions, data structures, and relationships across systems.",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re9",
      "col": "responsibility",
      "label": "Support the documentation of data templates, mappings, transformation logic and integration requirements.",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re10",
      "col": "responsibility",
      "label": "Work with senior consultants to clarify data inconsistencies, edge cases, and validation rules.",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re11",
      "col": "responsibility",
      "label": "Review API payloads (JSON/XML) to understand how data is exchanged between systems.",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re12",
      "col": "responsibility",
      "label": "Perform data patching when required.",
      "status": "stated",
      "prov": "mcf"
    },
    {
      "id": "re13",
      "col": "responsibility",
      "label": "Maintain clear and well-structured documentation such as data mapping sheets, integration specifications (functional level), test scenarios and results.",
      "status": "stated",
      "prov": "mcf"
    }
  ],
