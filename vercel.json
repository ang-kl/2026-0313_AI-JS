{
  "buildCommand": "npm run build && cd v3 && npm install --no-audit --no-fund && npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1", "hnd1"],
  "functions": {
    "api/claude.js":     { "maxDuration": 300 },
    "api/esco.js":       { "maxDuration": 30  },
    "api/v3/claude.js":  { "maxDuration": 300 },
    "api/v3/esco.js":    { "maxDuration": 30  },
    "api/v3/mcf.js":     { "maxDuration": 30  },
    "api/v3/datagov.js": { "maxDuration": 15  }
  },
  "fluid": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://va.vercel-scripts.com https://cdn.vercel-insights.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.anthropic.com https://api.mycareersfuture.gov.sg https://api-production.data.gov.sg https://vitals.vercel-insights.com https://va.vercel-scripts.com; object-src 'none'; base-uri 'self'; frame-src 'none'; img-src 'self' data:;" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/v3/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/v3",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/v3", "destination": "/v3/index.html" },
    { "source": "/v3/((?!assets/).*)", "destination": "/v3/index.html" },
    { "source": "/((?!api/|v3/|v3$).*)", "destination": "/index.html" }
  ]
}
