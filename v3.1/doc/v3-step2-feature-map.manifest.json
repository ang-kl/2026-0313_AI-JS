  "payloadFields": [
    {
      "id": "PAY-STEP2-QUERY-001",
      "name": "Role title query",
      "source": "User-entered landing input or Step 1a selected role title",
      "required": true,
      "fields": [
        "title"
      ],
      "absenceBehaviour": "Do not fetch Step 2 postings without a query; return to the landing/search state.",
      "inferenceAllowed": false
    },
    {
      "id": "PAY-STEP2-MCF-001",
      "name": "MyCareersFuture posting payload",
      "source": "v3.1/api/mcf.js normaliseJob",
      "required": false,
      "fields": [
        "uuid",
        "title",
        "employer",
        "postedCompanyName",
        "hiringCompanyName",
        "salaryMin",
        "salaryMax",
        "employmentType",
        "postedDate",
        "expiryDate",
        "applicationCount",
        "minimumYearsExperience",
        "positionLevels",
        "schemes",
        "description",
        "responsibilitiesText",
        "categories",
        "skills",
        "mcfUrl"
      ],
      "absenceBehaviour": "Show zero MCF cards and keep any careers.gov.sg cards; if all source lists fail, show the Step 2 error/empty state.",
      "inferenceAllowed": false
    },
    {
      "id": "PAY-STEP2-CAREERS-001",
      "name": "careers.gov.sg posting payload",
