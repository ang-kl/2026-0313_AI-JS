      "inferenceAllowed": false
    },
    {
      "id": "PAY-STEP2-SSOC-001",
      "name": "SSOC classification payload",
      "source": "v3.1/src/App.jsx classifyPostings and v3.1/api/ssoc.js classifyTitles",
      "required": false,
      "fields": [
        "id",
        "title",
        "skills",
        "categories",
        "description",
        "node.code",
        "hierarchy.major_group",
        "hierarchy.sub_major_group",
        "hierarchy.minor_group",
